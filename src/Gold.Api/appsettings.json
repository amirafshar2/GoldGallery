{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=gold.db"
  },
  "Jwt": {
    "Issuer": "gold-api",
    "Audience": "gold-web",
    "AccessMinutes": 15,
    "Key": ""
  },
  "Security": {
    "HashKey": ""
  },
  "DemoLogin": {
    "Enabled": false
  },
  "Cors": {
    "Origins": []
  },
  "RateLimits": {
    "Otp": 5,
    "Auth": 20,
    "Payment": 20,
    "Global": 300
  },
  "Seed": {
    "Mode": "Demo"
  },
  "Setup": {
    "Token": ""
  },
  "Media": {},
  "RateGuard": {
    "MaxAgeMinutes": 30,
    "MaxJumpPercent": 5
  },
  "Payment": {
    "CallbackBaseUrl": "",
    "ResultPageUrl": "/checkout/result"
  }
}